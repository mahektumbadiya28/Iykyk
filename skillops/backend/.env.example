# SkillOps Backend Environment Configuration
# Copy this to .env and fill in your values

# ──────────────────────────────────────────────────────────────
# REQUIRED: Get your free Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Change the AI model (default is excellent)
# Options: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# ──────────────────────────────────────────────────────────────
# Database (SQLite is default, no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./skillops.db

# ──────────────────────────────────────────────────────────────
# Server settings
HOST=0.0.0.0
PORT=8000
